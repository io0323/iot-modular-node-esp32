# Doxygen の設定（open-questions #83、docs/quality.md）。src/**/*.hpp の公開 API。警告は失敗にする。
# 出力（HTML）は build/quality/doxygen/ に置き、コミットしない（CI の成果物）。
PROJECT_NAME           = "mcu-cpp-01"
PROJECT_BRIEF          = "作品02 モジュール型スマートデバイス制御システム"
OUTPUT_DIRECTORY       = build/quality/doxygen
OUTPUT_LANGUAGE        = Japanese
INPUT                  = src
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE                = src/drivers/font5x7.hpp
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
INTERNAL_DOCS          = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/quality/doxygen/warnings.txt
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
# 構成表（config/hw_table.hpp・fakehw_table.hpp）をクラスの中で読むため（#145）
INCLUDE_PATH           = src
